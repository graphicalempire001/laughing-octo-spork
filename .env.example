# Required in production: the admin password for /admin
ADMIN_PASSWORD=change-me-to-something-long
# Optional: secret for signing the login cookie (defaults to the password)
SESSION_SECRET=
# Optional: where menu.json and uploaded WebP images are kept. Point at a persistent volume (e.g. /data).
DATA_DIR=

# Public site address (used for SEO, sitemap, social previews). Default: https://ubuntujollof.com
NEXT_PUBLIC_SITE_URL=https://ubuntujollof.com
