# Required in production: the first staff password for /onions (can then be changed inside the dashboard)
ADMIN_PASSWORD=change-me-to-something-long
# Optional: secret for signing the login cookie (defaults to the password)
SESSION_SECRET=
# Optional: where menu.json and uploaded WebP images are kept. Point at a persistent volume (e.g. /data).
DATA_DIR=

# Public address is built in: https://ubuntujollof.online. Do NOT set NEXT_PUBLIC_SITE_URL anymore (delete it on your host).
# Only if you move to another domain: SITE_URL_OVERRIDE=https://your-new-domain

# Supabase (production). Server-only keys: never expose the service-role key in the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: storage bucket name (default menu-images)
SUPABASE_BUCKET=menu-images
